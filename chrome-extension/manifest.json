{
  "manifest_version": 3,
  "name": "Gmail Email Risk Assessor",
  "version": "0.1.0",
  "description": "Provides a heuristic risk assessment of the currently opened Gmail email for phishing and suspicious signals.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "https://mail.google.com/*"],
  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Gmail Email",
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  }
}
